generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization (multi-tenant root)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  plan      String   @default("free") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users                  User[]
  apiKeys                ApiKey[]
  installTokens          InstallToken[]
  projects               Project[]
  repositories           Repository[]
  scans                  Scan[]
  findings               Finding[]
  integrations           Integration[]
  auditLogs              AuditLog[]
  notificationPreferences NotificationPreference[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  orgId        String   @map("org_id") @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(100)
  role         String   @default("member") @db.VarChar(20) // owner | admin | member | viewer
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// API Key (hashed, prefix-based lookup)
// ---------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(uuid()) @db.VarChar(36)
  orgId      String    @map("org_id") @db.VarChar(36)
  createdBy  String    @map("created_by") @db.VarChar(36)
  name       String    @db.VarChar(100)
  keyHash    String    @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(30)
  scopes     Json      @default("[]") @db.Json
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Install Token (agent provisioning, one-time use)
// ---------------------------------------------------------------------------

model InstallToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  orgId     String    @map("org_id") @db.VarChar(36)
  projectId String?   @map("project_id") @db.VarChar(36)
  tokenHash String    @map("token_hash") @db.VarChar(64)
  label     String    @default("") @db.VarChar(100)
  tags      Json      @default("[]") @db.Json
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  usedBy    String?   @map("used_by") @db.VarChar(36)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  org     Organization @relation(fields: [orgId], references: [id])
  project Project?     @relation(fields: [projectId], references: [id])

  @@index([orgId])
  @@index([tokenHash])
  @@map("install_tokens")
}

// ---------------------------------------------------------------------------
// Project (logical asset grouping)
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(uuid()) @db.VarChar(36)
  orgId       String   @map("org_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(1000)
  notes       String   @default("") @db.Text
  banner      String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  org               Organization       @relation(fields: [orgId], references: [id])
  servers           Server[]
  monitoredEndpoints MonitoredEndpoint[]
  installTokens     InstallToken[]
  repositories      Repository[]

  @@index([orgId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Server (agent-monitored)
// ---------------------------------------------------------------------------

model Server {
  id            String    @id @default(uuid()) @db.VarChar(36)
  orgId         String    @map("org_id") @db.VarChar(36)
  projectId     String?   @map("project_id") @db.VarChar(36)
  label         String    @default("") @db.VarChar(100)
  hostname      String    @db.VarChar(255)
  agentId       String?   @unique @map("agent_id") @db.VarChar(36)
  agentVersion  String?   @map("agent_version") @db.VarChar(20)
  osFamily      String?   @map("os_family") @db.VarChar(50)
  osVersion     String?   @map("os_version") @db.VarChar(50)
  kernel        String?   @db.VarChar(100)
  cpuCores      Int?      @map("cpu_cores")
  cpuModel      String?   @map("cpu_model") @db.VarChar(200)
  totalRamMb    Int?      @map("total_ram_mb")
  totalDiskGb   Int?      @map("total_disk_gb")
  ipAddresses   Json?     @map("ip_addresses") @db.Json  // ["192.168.1.10", ...]
  status        String    @default("offline") @db.VarChar(20) // online | offline | warning | critical
  securityScore Int?      @map("security_score")  // 0–100, computed server-side
  tags          Json      @default("[]") @db.Json
  lastHeartbeat DateTime? @map("last_heartbeat") @db.DateTime(3)
  apiKeyHash    String?   @map("api_key_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  project            Project?              @relation(fields: [projectId], references: [id])
  metrics            ServerMetricSnapshot[]
  findings           Finding[]
  securityPosture    SecurityPosture[]
  packageInventories PackageInventory[]
  scoreHistory       ServerScoreHistory[]
  attackSurfaceScans AttackSurfaceScan[]

  @@index([orgId])
  @@index([projectId])
  @@map("servers")
}

model AttackSurfaceScan {
  id          String    @id @default(uuid()) @db.VarChar(36)
  serverId    String    @map("server_id") @db.VarChar(36)
  orgId       String    @map("org_id") @db.VarChar(36)
  targetIp    String    @map("target_ip") @db.VarChar(45)
  status      String    @default("pending") @db.VarChar(20) // pending | running | completed | failed
  openPorts   Json?     @map("open_ports") @db.Json
  adminPanels Json?     @map("admin_panels") @db.Json
  summary     Json?     @db.Json
  startedAt   DateTime? @map("started_at") @db.DateTime(3)
  completedAt DateTime? @map("completed_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@index([orgId])
  @@map("attack_surface_scans")
}

model ServerScoreHistory {
  id        String   @id @default(uuid()) @db.VarChar(36)
  serverId  String   @map("server_id") @db.VarChar(36)
  score     Int      // 0–100
  breakdown Json     @db.Json  // {critical:N, high:N, medium:N, low:N}
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@map("server_score_history")
}

// ---------------------------------------------------------------------------
// Repository (code scanning target)
// ---------------------------------------------------------------------------

model Repository {
  id            String    @id @default(uuid()) @db.VarChar(36)
  orgId         String    @map("org_id") @db.VarChar(36)
  projectId     String?   @map("project_id") @db.VarChar(36)
  integrationId String?   @map("integration_id") @db.VarChar(36)
  provider      String    @db.VarChar(20) // github | gitlab
  providerId    String    @map("provider_id") @db.VarChar(100)
  owner         String    @db.VarChar(255)
  name          String    @db.VarChar(255)
  defaultBranch String    @default("main") @map("default_branch") @db.VarChar(100)
  language      String?   @db.VarChar(50)
  cloneUrl      String?   @map("clone_url") @db.VarChar(500)
  lastScanAt    DateTime? @map("last_scan_at") @db.DateTime(3)
  settings      Json      @default("{}") @db.Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  org         Organization @relation(fields: [orgId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  scans       Scan[]
  findings    Finding[]

  @@unique([orgId, provider, providerId])
  @@index([orgId])
  @@index([projectId])
  @@index([integrationId])
  @@map("repositories")
}

// ---------------------------------------------------------------------------
// ServerMetricSnapshot (time-series from heartbeats)
// ---------------------------------------------------------------------------

model ServerMetricSnapshot {
  id            String   @id @default(uuid()) @db.VarChar(36)
  serverId      String   @map("server_id") @db.VarChar(36)
  cpu           Float
  memory        Float
  disk          Float
  urgent        Boolean  @default(false)
  alerts        Json     @default("[]") @db.Json
  cpuIoWait     Float?   @map("cpu_io_wait")
  swapUsedPct   Float?   @map("swap_used_pct")
  loadAvg1      Float?   @map("load_avg_1")
  loadAvg5      Float?   @map("load_avg_5")
  loadAvg15     Float?   @map("load_avg_15")
  diskReadBps   BigInt?  @map("disk_read_bps")
  diskWriteBps  BigInt?  @map("disk_write_bps")
  diskIoUtil    Float?   @map("disk_io_util")
  netRxBps      BigInt?  @map("net_rx_bps")
  netTxBps      BigInt?  @map("net_tx_bps")
  netErrors     Int?     @map("net_errors")
  docker        Json?    @db.Json
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@map("server_metric_snapshots")
}

// ---------------------------------------------------------------------------
// SecurityPosture (hourly agent security scan)
// ---------------------------------------------------------------------------

model SecurityPosture {
  id             String   @id @default(uuid()) @db.VarChar(36)
  serverId       String   @map("server_id") @db.VarChar(36)
  collectedAt    DateTime @map("collected_at") @db.DateTime(3)
  listeningPorts Json     @map("listening_ports") @db.Json     // [{port,proto,process,bind}]
  sshConfig      Json     @map("ssh_config") @db.Json          // {rootLogin,passwordAuth,port,permitEmptyPwd}
  firewallActive Boolean  @map("firewall_active")
  firewallType   String   @map("firewall_type") @db.VarChar(20)
  loggedInUsers  Json     @map("logged_in_users") @db.Json     // [{user,from,since}]
  sshFailures    Int      @map("ssh_failures") @default(0)
  shellUsers     Json     @map("shell_users") @db.Json         // ["root","ubuntu"]
  pendingReboot  Boolean  @map("pending_reboot") @default(false)
  openFdAlloc    Int?     @map("open_fd_alloc")
  openFdMax      Int?     @map("open_fd_max")
  auditResults   Json?    @map("audit_results") @db.Json   // [{id,category,title,status,severity,detail}]
  bruteForce     Json?    @map("brute_force") @db.Json    // {sshVelocity, sshUniqueIps, ...}
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@map("security_postures")
}

// ---------------------------------------------------------------------------
// PackageInventory (daily agent package scan for CVE matching)
// ---------------------------------------------------------------------------

model PackageInventory {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  serverId               String   @map("server_id") @db.VarChar(36)
  collectedAt            DateTime @map("collected_at") @db.DateTime(3)
  osFamily               String   @map("os_family") @db.VarChar(50)
  packages               Json     @db.Json
  binaryVersions         Json     @map("binary_versions") @db.Json
  pendingSecurityUpdates Int      @map("pending_security_updates") @default(0)
  heldPackages           Json     @map("held_packages") @db.Json
  kernelRunning          String?  @map("kernel_running") @db.VarChar(100)
  kernelInstalled        String?  @map("kernel_installed") @db.VarChar(100)
  unattendedUpgrades     Boolean  @map("unattended_upgrades") @default(false)
  packageHash            String   @map("package_hash") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(3)

  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId, collectedAt])
  @@map("package_inventories")
}

// ---------------------------------------------------------------------------
// VulnerabilityFeed (cached CVE database feeds)
// ---------------------------------------------------------------------------

model VulnerabilityFeed {
  id         String   @id @default(uuid()) @db.VarChar(36)
  source     String   @unique @db.VarChar(50)
  lastSyncAt DateTime @map("last_sync_at") @db.DateTime(3)
  data       Json     @db.Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("vulnerability_feeds")
}

// ---------------------------------------------------------------------------
// MonitoredEndpoint (domain/SSL/uptime)
// ---------------------------------------------------------------------------

model MonitoredEndpoint {
  id              String   @id @default(uuid()) @db.VarChar(36)
  orgId           String   @map("org_id") @db.VarChar(36)
  projectId       String?  @map("project_id") @db.VarChar(36)
  host            String   @db.VarChar(255)
  port            Int      @default(443)
  protocol        String   @default("https") @db.VarChar(10)
  // Tags — [{key: "env", value: "prod"}, ...]
  tags            Json     @default("[]") @db.Json
  // Uptime check settings
  uptimeInterval  Int      @default(15)  @map("uptime_interval")  // seconds between pings
  uptimeTimeout   Int      @default(30)  @map("uptime_timeout")   // seconds before timeout
  // SSL/DNS check — runs on create, then daily via scheduler
  lastSslCheckAt  DateTime? @map("last_ssl_check_at") @db.DateTime(3)
  // Legacy field kept for backwards compat
  checkInterval   String   @default("1h") @map("check_interval") @db.VarChar(10)
  status          String   @default("pending") @db.VarChar(20) // healthy | degraded | down | pending
  lastCheckAt     DateTime? @map("last_check_at") @db.DateTime(3)
  nextCheckAt     DateTime? @map("next_check_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project    Project?            @relation(fields: [projectId], references: [id])
  heartbeats EndpointHeartbeat[]

  @@index([orgId])
  @@index([projectId])
  @@index([nextCheckAt])
  @@map("monitored_endpoints")
}

// ---------------------------------------------------------------------------
// EndpointHeartbeat (uptime check results)
// ---------------------------------------------------------------------------

model EndpointHeartbeat {
  id         String   @id @default(uuid()) @db.VarChar(36)
  endpointId String   @map("endpoint_id") @db.VarChar(36)
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  isUp       Boolean  @map("is_up")
  sslValid   Boolean? @map("ssl_valid")
  sslExpiry  DateTime? @map("ssl_expiry") @db.DateTime(3)
  sslIssuer  String?  @map("ssl_issuer") @db.VarChar(255)
  sslDaysLeft Int?    @map("ssl_days_left")
  tlsVersion String?  @map("tls_version") @db.VarChar(20)
  dnsSpf     String?  @map("dns_spf") @db.VarChar(20)   // pass | fail | missing
  dnsDkim    String?  @map("dns_dkim") @db.VarChar(20)
  dnsDmarc   String?  @map("dns_dmarc") @db.VarChar(20)
  details    Json?    @db.Json
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  endpoint MonitoredEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("endpoint_heartbeats")
}

// ---------------------------------------------------------------------------
// Scan
// ---------------------------------------------------------------------------

model Scan {
  id            String    @id @default(uuid()) @db.VarChar(36)
  orgId         String    @map("org_id") @db.VarChar(36)
  repositoryId  String?   @map("repository_id") @db.VarChar(36)
  type          String    @db.VarChar(30)   // code_dependencies | code_secrets | code_configs | code_patterns | infra_packages | infra_compliance | cert_discovery | cert_check
  status        String    @default("pending") @db.VarChar(20) // pending | running | completed | failed | cancelled
  trigger       String    @default("manual") @db.VarChar(20) // manual | scheduled | webhook
  branch        String?   @db.VarChar(255)
  duration      Int?      // milliseconds
  findingsTotal Int       @default(0) @map("findings_total")
  meta          Json?     @db.Json
  startedAt     DateTime? @map("started_at") @db.DateTime(3)
  completedAt   DateTime? @map("completed_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  org        Organization @relation(fields: [orgId], references: [id])
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  findings   Finding[]

  @@index([orgId])
  @@index([repositoryId])
  @@map("scans")
}

// ---------------------------------------------------------------------------
// Finding (vulnerability / issue)
// ---------------------------------------------------------------------------

model Finding {
  id           String    @id @default(uuid()) @db.VarChar(36)
  orgId        String    @map("org_id") @db.VarChar(36)
  scanId       String?   @map("scan_id") @db.VarChar(36)
  repositoryId String?   @map("repository_id") @db.VarChar(36)
  serverId     String?   @map("server_id") @db.VarChar(36)
  endpointId   String?   @map("endpoint_id") @db.VarChar(36)
  source       String    @db.VarChar(30) // code_scanner | infra_agent | cert_monitor
  severity     String    @db.VarChar(10) // critical | high | medium | low | info
  status       String    @default("open") @db.VarChar(20) // open | in_progress | resolved | suppressed | false_positive
  title        String    @db.VarChar(500)
  description  String?   @db.Text
  cveId        String?   @map("cve_id") @db.VarChar(30)
  cvssScore    Float?    @map("cvss_score")
  detail       Json?     @db.Json
  resolvedAt   DateTime? @map("resolved_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  org        Organization @relation(fields: [orgId], references: [id])
  scan       Scan?        @relation(fields: [scanId], references: [id])
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  server     Server?      @relation(fields: [serverId], references: [id])

  @@index([orgId])
  @@index([orgId, severity])
  @@index([orgId, status])
  @@index([repositoryId])
  @@map("findings")
}

// ---------------------------------------------------------------------------
// Integration (github | gitlab | slack)
// ---------------------------------------------------------------------------

model Integration {
  id            String   @id @default(uuid()) @db.VarChar(36)
  orgId         String   @map("org_id") @db.VarChar(36)
  provider      String   @db.VarChar(20) // github | gitlab
  config        Json     @db.Json // encrypted tokens, appId, installationId, etc.
  baseUrl       String?  @map("base_url") @db.VarChar(500) // self-hosted URL (null = cloud)
  verifySsl     Boolean  @default(true) @map("verify_ssl")
  webhookSecret String?  @map("webhook_secret") @db.VarChar(255)
  status        String   @default("active") @db.VarChar(20) // active | error | revoked
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  org          Organization @relation(fields: [orgId], references: [id])
  repositories Repository[]

  @@unique([orgId, provider])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  orgId      String   @map("org_id") @db.VarChar(36)
  actorId    String?  @map("actor_id") @db.VarChar(36)
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(36)
  oldValues  Json?    @map("old_values") @db.Json
  newValues  Json?    @map("new_values") @db.Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// NotificationPreference
// ---------------------------------------------------------------------------

model NotificationPreference {
  id        String   @id @default(uuid()) @db.VarChar(36)
  orgId     String   @map("org_id") @db.VarChar(36)
  channel   String   @db.VarChar(20) // email | slack | webhook
  eventType String   @map("event_type") @db.VarChar(50)
  enabled   Boolean  @default(true)
  config    Json?    @db.Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, channel, eventType])
  @@map("notification_preferences")
}
